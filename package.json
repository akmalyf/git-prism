{
  "name": "jetbrains-git-tools",
  "displayName": "JetBrains Git Tools",
  "description": "PhpStorm / IntelliJ-style Git tools: Commit tool window, Git Log with graph, Compare with Branch/Revision, History, Annotate, Branches popup, Push/Pull/Merge/Rebase dialogs, Interactive Rebase, conflict resolver, Stash and Shelf.",
  "version": "0.1.0",
  "publisher": "akmalyf",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "jetbrains",
    "phpstorm",
    "intellij",
    "git log",
    "commit",
    "rebase",
    "merge",
    "blame"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jbGitCommit",
          "title": "Commit",
          "icon": "$(git-commit)"
        }
      ],
      "panel": [
        {
          "id": "jbGitPanel",
          "title": "Git",
          "icon": "$(git-branch)"
        }
      ]
    },
    "commands": [
      {
        "command": "jbGit.console.show",
        "title": "Show Git Console",
        "category": "Git"
      }
    ],
    "configuration": {
      "title": "JetBrains Git Tools",
      "properties": {
        "jbGit.gitPath": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses `git` from PATH."
        }
      }
    },
    "submenus": [
      {
        "id": "jbGit.fileMenu",
        "label": "Git"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "jbGit.fileMenu",
          "group": "jbgit@1",
          "when": "jbGit.active"
        }
      ],
      "editor/context": [
        {
          "submenu": "jbGit.fileMenu",
          "group": "jbgit@1",
          "when": "jbGit.active"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "jbGit.fileMenu",
          "group": "jbgit@1",
          "when": "jbGit.active"
        }
      ]
    }
  },
  "scripts": {
    "contributes": "node scripts/merge-contributes.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "vscode:prepublish": "npm run contributes && npm run typecheck && npm run build",
    "package": "vsce package --no-dependencies",
    "test": "node scripts/build.mjs --test && node --test dist-test/"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@ide-diff/core": "file:vendor/ide-diff-core-0.1.0.tgz",
    "@ide-diff/viewer": "file:vendor/ide-diff-viewer-0.1.0.tgz",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.140.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
