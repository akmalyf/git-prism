{
  "commands": [
    {
      "command": "gitPrism.commit.focus",
      "title": "Commit\u2026",
      "category": "Git",
      "icon": "$(git-commit)"
    },
    {
      "command": "gitPrism.add",
      "title": "Add",
      "category": "Git"
    },
    {
      "command": "gitPrism.addToGitignore",
      "title": "Add to .gitignore",
      "category": "Git"
    },
    {
      "command": "gitPrism.rollback",
      "title": "Rollback\u2026",
      "category": "Git"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "gitPrism.add",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.addToGitignore",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.rollback",
        "when": "gitPrism.active"
      }
    ],
    "gitPrism.fileMenu": [
      {
        "command": "gitPrism.add",
        "group": "1_commit@2"
      },
      {
        "command": "gitPrism.addToGitignore",
        "group": "1_commit@3"
      },
      {
        "command": "gitPrism.rollback",
        "group": "3_rollback@1"
      }
    ]
  }
}
