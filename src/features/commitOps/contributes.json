  "configuration": {
    "properties": {
      "gitPrism.cherryPick.addSuffix": {
        "type": "boolean",
        "default": false,
        "description": "Add the 'cherry-picked from <hash>' suffix when picking commits pushed to protected branches (gitPrism.push.protectedBranches)"
      },
      "gitPrism.commitOps.showDropCommitDialog": {
        "type": "boolean",
        "default": true,
        "description": "Show the confirmation dialog before Drop Commits (unset by \"OK, Don't Ask Again\"). Protected branches for history editing are the ones of gitPrism.push.protectedBranches."
      }
    }
