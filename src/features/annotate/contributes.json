{
  "commands": [
    {
      "command": "gitPrism.annotate.toggle",
      "title": "Annotate with Git Blame",
      "category": "Git",
      "icon": "$(git-commit)"
    },
    {
      "command": "gitPrism.annotate.close",
      "title": "Close Annotations",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.revision",
      "title": "Annotate Revision",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.currentRevision",
      "title": "Annotate Revision",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.previous",
      "title": "Annotate Previous Revision",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.previousRevision",
      "title": "Annotate Previous Revision",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.showDiff",
      "title": "Show Diff",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.showAffectedFiles",
      "title": "Show Affected Files",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.showCommitInLog",
      "title": "Show in Git Log",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.copyRevision",
      "title": "Copy Revision Number",
      "category": "Git"
    },
    {
      "command": "gitPrism.annotate.view.revision",
      "title": "Revision",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.showRevision"
    },
    {
      "command": "gitPrism.annotate.view.date",
      "title": "Date",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.showDate"
    },
    {
      "command": "gitPrism.annotate.view.author",
      "title": "Author",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.showAuthor"
    },
    {
      "command": "gitPrism.annotate.view.subject",
      "title": "Commit Subject",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.showSubject"
    },
    {
      "command": "gitPrism.annotate.names.initials",
      "title": "Initials",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.names == 'initials'"
    },
    {
      "command": "gitPrism.annotate.names.lastName",
      "title": "Last Name",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.names == 'lastName'"
    },
    {
      "command": "gitPrism.annotate.names.firstName",
      "title": "First Name",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.names == 'firstName'"
    },
    {
      "command": "gitPrism.annotate.names.fullName",
      "title": "Full Name",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.names == 'fullName'"
    },
    {
      "command": "gitPrism.annotate.names.email",
      "title": "Email",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.names == 'email'"
    },
    {
      "command": "gitPrism.annotate.colors.order",
      "title": "Order",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.colors == 'order'"
    },
    {
      "command": "gitPrism.annotate.colors.author",
      "title": "Author",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.colors == 'author'"
    },
    {
      "command": "gitPrism.annotate.colors.hide",
      "title": "Hide",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.colors == 'hide'"
    },
    {
      "command": "gitPrism.annotate.option.ignoreWhitespaces",
      "title": "Ignore Whitespaces",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.ignoreWhitespaces"
    },
    {
      "command": "gitPrism.annotate.option.detectWithinFile",
      "title": "Detect Movements Within File",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.detectMovements == 'inner' || config.gitPrism.annotate.detectMovements == 'outer'"
    },
    {
      "command": "gitPrism.annotate.option.detectAcrossFiles",
      "title": "Detect Movements Across Files",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.detectMovements == 'outer'"
    },
    {
      "command": "gitPrism.annotate.option.commitTimestamp",
      "title": "Show Commit Timestamp",
      "category": "Git",
      "toggled": "config.gitPrism.annotate.preferCommitTimestamp"
    },
    {
      "command": "gitPrism.rollbackLines",
      "title": "Rollback Lines",
      "category": "Git"
    },
    {
      "command": "gitPrism.showDiffForLines",
      "title": "Show Diff for Lines",
      "category": "Git"
    },
    {
      "command": "gitPrism.copyHunkOriginal",
      "title": "Copy Original Lines",
      "category": "Git"
    }
  ],
  "submenus": [
    {
      "id": "gitPrism.annotate.viewMenu",
      "label": "View"
    },
    {
      "id": "gitPrism.annotate.namesMenu",
      "label": "Names"
    },
    {
      "id": "gitPrism.annotate.colorsMenu",
      "label": "Colors"
    },
    {
      "id": "gitPrism.annotate.optionsMenu",
      "label": "Options"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "gitPrism.annotate.option.commitTimestamp",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.revision",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.previous",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.view.revision",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.view.date",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.view.author",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.view.subject",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.names.initials",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.names.lastName",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.names.firstName",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.names.fullName",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.names.email",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.colors.order",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.colors.author",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.colors.hide",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.option.ignoreWhitespaces",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.option.detectWithinFile",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.option.detectAcrossFiles",
        "when": "false"
      },
      {
        "command": "gitPrism.annotate.toggle",
        "when": "editorIsOpen && !gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.annotate.close",
        "when": "gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.annotate.previousRevision",
        "when": "gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.annotate.showDiff",
        "when": "gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.annotate.showAffectedFiles",
        "when": "gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.annotate.showCommitInLog",
        "when": "gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.annotate.copyRevision",
        "when": "gitPrism.annotate.active"
      },
      {
        "command": "gitPrism.rollbackLines",
        "when": "editorIsOpen && resourceScheme == file"
      },
      {
        "command": "gitPrism.showDiffForLines",
        "when": "editorIsOpen && resourceScheme == file"
      },
      {
        "command": "gitPrism.copyHunkOriginal",
        "when": "editorIsOpen && resourceScheme == file"
      },
      {
        "command": "gitPrism.annotate.currentRevision",
        "when": "gitPrism.annotate.active"
      }
    ],
    "editor/lineNumber/context": [
      {
        "command": "gitPrism.annotate.toggle",
        "group": "1_annotate@1",
        "when": "!(resourcePath in gitPrism.annotate.paths) && (resourceScheme == file || resourceScheme == gitprism-rev || resourceScheme == gitprism-annotate)"
      },
      {
        "command": "gitPrism.annotate.showDiff",
        "group": "1_annotate@1",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "submenu": "gitPrism.annotate.viewMenu",
        "group": "1_annotate@2",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.annotate.copyRevision",
        "group": "1_annotate@3",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.annotate.currentRevision",
        "group": "2_revision@1",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.annotate.previousRevision",
        "group": "2_revision@2",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "submenu": "gitPrism.annotate.optionsMenu",
        "group": "3_extensions@1",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.annotate.showAffectedFiles",
        "group": "3_extensions@2",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.annotate.showCommitInLog",
        "group": "3_extensions@3",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.annotate.close",
        "group": "4_close@1",
        "when": "resourcePath in gitPrism.annotate.paths"
      },
      {
        "command": "gitPrism.rollbackLines",
        "group": "5_changes@1",
        "when": "resourceScheme == file && !editorReadonly"
      },
      {
        "command": "gitPrism.showDiffForLines",
        "group": "5_changes@2",
        "when": "resourceScheme == file"
      },
      {
        "command": "gitPrism.copyHunkOriginal",
        "group": "5_changes@3",
        "when": "resourceScheme == file"
      }
    ],
    "gitPrism.fileMenu": [
      {
        "command": "gitPrism.annotate.toggle",
        "group": "2_diff@0",
        "when": "!explorerResourceIsFolder && !(resourcePath in gitPrism.annotate.paths)"
      },
      {
        "command": "gitPrism.annotate.close",
        "group": "2_diff@0",
        "when": "!explorerResourceIsFolder && resourcePath in gitPrism.annotate.paths"
      }
    ],
    "gitPrism.annotate.viewMenu": [
      {
        "command": "gitPrism.annotate.view.revision",
        "group": "1_aspects@0"
      },
      {
        "command": "gitPrism.annotate.view.date",
        "group": "1_aspects@1"
      },
      {
        "command": "gitPrism.annotate.view.author",
        "group": "1_aspects@2"
      },
      {
        "command": "gitPrism.annotate.view.subject",
        "group": "1_aspects@3"
      },
      {
        "submenu": "gitPrism.annotate.colorsMenu",
        "group": "2_presentation@0"
      },
      {
        "submenu": "gitPrism.annotate.namesMenu",
        "group": "2_presentation@1"
      }
    ],
    "gitPrism.annotate.namesMenu": [
      {
        "command": "gitPrism.annotate.names.initials",
        "group": "1@0"
      },
      {
        "command": "gitPrism.annotate.names.lastName",
        "group": "1@1"
      },
      {
        "command": "gitPrism.annotate.names.firstName",
        "group": "1@2"
      },
      {
        "command": "gitPrism.annotate.names.fullName",
        "group": "1@3"
      },
      {
        "command": "gitPrism.annotate.names.email",
        "group": "1@4"
      }
    ],
    "gitPrism.annotate.colorsMenu": [
      {
        "command": "gitPrism.annotate.colors.order",
        "group": "1@0"
      },
      {
        "command": "gitPrism.annotate.colors.author",
        "group": "1@1"
      },
      {
        "command": "gitPrism.annotate.colors.hide",
        "group": "1@2"
      }
    ],
    "gitPrism.annotate.optionsMenu": [
      {
        "command": "gitPrism.annotate.option.ignoreWhitespaces",
        "group": "1@0"
      },
      {
        "command": "gitPrism.annotate.option.detectWithinFile",
        "group": "1@1"
      },
      {
        "command": "gitPrism.annotate.option.detectAcrossFiles",
        "group": "1@2"
      },
      {
        "command": "gitPrism.annotate.option.commitTimestamp",
        "group": "1@3"
      }
    ]
  },
  "keybindings": [
    {
      "command": "gitPrism.rollbackLines",
      "key": "ctrl+alt+z",
      "mac": "cmd+alt+z",
      "when": "editorTextFocus && !editorReadonly && resourceScheme == file"
    }
  ],
  "configuration": {
    "properties": {
      "gitPrism.annotate.showRevision": {
        "type": "boolean",
        "default": false,
        "description": "Annotations: show the short commit hash (Revision)."
      },
      "gitPrism.annotate.showDate": {
        "type": "boolean",
        "default": true,
        "description": "Annotations: show the commit date."
      },
      "gitPrism.annotate.showAuthor": {
        "type": "boolean",
        "default": true,
        "description": "Annotations: show the author."
      },
      "gitPrism.annotate.showSubject": {
        "type": "boolean",
        "default": false,
        "description": "Annotations: show the commit subject."
      },
      "gitPrism.annotate.names": {
        "type": "string",
        "enum": [
          "initials",
          "lastName",
          "firstName",
          "fullName",
          "email"
        ],
        "enumItemLabels": [
          "Initials",
          "Last Name",
          "First Name",
          "Full Name",
          "Email"
        ],
        "default": "lastName",
        "description": "Annotations: how author names are shown."
      },
      "gitPrism.annotate.colors": {
        "type": "string",
        "enum": [
          "order",
          "author",
          "hide"
        ],
        "enumDescriptions": [
          "Color by commit age: recent commits are more saturated",
          "A color per author",
          "No background colors"
        ],
        "default": "order",
        "description": "Annotations: background colors."
      },
      "gitPrism.annotate.ignoreWhitespaces": {
        "type": "boolean",
        "default": true,
        "description": "Annotations: ignore whitespace changes (git blame -w)."
      },
      "gitPrism.annotate.detectMovements": {
        "type": "string",
        "enum": [
          "none",
          "inner",
          "outer"
        ],
        "enumItemLabels": [
          "None",
          "Detect Movements Within File",
          "Detect Movements Across Files"
        ],
        "enumDescriptions": [
          "git blame without -M/-C",
          "git blame -M: lines moved or copied within the file",
          "git blame -C: also lines moved or copied from other files of the same commit"
        ],
        "default": "none",
        "description": "Annotations: detect moved or copied lines."
      },
      "gitPrism.annotate.preferCommitTimestamp": {
        "type": "boolean",
        "default": false,
        "description": "Annotations: show the commit timestamp instead of the author timestamp."
      }
    }
  }
}
