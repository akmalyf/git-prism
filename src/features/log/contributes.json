{
  "views": {
    "gitPrismPanel": [
      {
        "type": "webview",
        "id": "gitPrism.logView",
        "name": "Log",
        "when": "gitPrism.active"
      }
    ]
  },
  "commands": [
    {
      "command": "gitPrism.log.show",
      "title": "Show VCS Log",
      "category": "Git",
      "icon": "$(git-commit)"
    },
    {
      "command": "gitPrism.log.refresh",
      "title": "Refresh",
      "category": "Git",
      "icon": "$(refresh)"
    },
    {
      "command": "gitPrism.log.openInEditor",
      "title": "Open New Git Log Editor Tab",
      "category": "Git",
      "icon": "$(add)"
    },
    {
      "command": "gitPrism.log.goToRef",
      "title": "Go To Hash/Branch/Tag",
      "category": "Git"
    },
    {
      "command": "gitPrism.log.focusTextFilter",
      "title": "Focus Text Filter",
      "category": "Git"
    },
    {
      "command": "gitPrism.log.showConsoleTab",
      "title": "Show Git Console",
      "category": "Git"
    },
    {
      "command": "gitPrism.log.clearConsole",
      "title": "Clear All",
      "category": "Git",
      "icon": "$(clear-all)"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "gitPrism.log.show",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.log.refresh",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.log.openInEditor",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.log.goToRef",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.log.focusTextFilter",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.log.showConsoleTab",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.log.clearConsole",
        "when": "false"
      }
    ],
    "view/title": [
      {
        "command": "gitPrism.log.openInEditor",
        "when": "view == gitPrism.logView",
        "group": "navigation@1"
      }
    ]
  },
  "configuration": {
    "properties": {
      "gitPrism.log.sortType": {
        "type": "string",
        "enum": [
          "topological",
          "date"
        ],
        "enumDescriptions": [
          "Topologically: in case of merge, show incoming commits first, directly below merge commit",
          "By Commit Date: sort commits topologically and by commit date"
        ],
        "default": "date",
        "description": "Git Log: commit sort order."
      },
      "gitPrism.log.firstParent": {
        "type": "boolean",
        "default": false,
        "description": "Git Log: First Parent \u2014 follow only the first parent commit upon seeing a merge commit."
      },
      "gitPrism.log.showLongEdges": {
        "type": "boolean",
        "default": false,
        "description": "Git Log: Long Edges \u2014 show long graph edges instead of cutting them behind arrows."
      },
      "gitPrism.log.columns": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "author",
            "subject",
            "date",
            "hash",
            "root"
          ]
        },
        "default": [
          "author",
          "subject",
          "date"
        ],
        "description": "Git Log: visible columns in display order (subject holds the graph and references)."
      },
      "gitPrism.log.preferCommitDate": {
        "type": "boolean",
        "default": false,
        "description": "Git Log: Commit Timestamp \u2014 show the time when the change was committed rather than authored."
      },
      "gitPrism.log.dateFormat": {
        "type": "string",
        "default": "",
        "description": "Git Log: date format pattern (yyyy, yy, MM, M, dd, d, HH, H, mm, ss). Empty uses the locale format."
      },
      "gitPrism.log.prettyDates": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: show recent dates as Today / Yesterday."
      },
      "gitPrism.log.highlightMyCommits": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: Highlight \u203a My Commits (bold)."
      },
      "gitPrism.log.highlightMergeCommits": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: Highlight \u203a Merge Commits (grey)."
      },
      "gitPrism.log.highlightCurrentBranch": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: Highlight \u203a Current Branch."
      },
      "gitPrism.log.showTagNames": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: Tag Names \u2014 show tag names in the table."
      },
      "gitPrism.log.compactReferences": {
        "type": "boolean",
        "default": false,
        "description": "Git Log: Compact References View \u2014 show only the first reference for a commit in the table."
      },
      "gitPrism.log.referencesOnLeft": {
        "type": "boolean",
        "default": false,
        "description": "Git Log: References on the Left \u2014 show references on the left of commit message."
      },
      "gitPrism.log.showDetails": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: Show Details \u2014 commit details below the changed files."
      },
      "gitPrism.log.showDiffPreview": {
        "type": "boolean",
        "default": false,
        "description": "Git Log: Show Diff Preview."
      },
      "gitPrism.log.diffPreviewLocation": {
        "type": "string",
        "enum": [
          "right",
          "bottom"
        ],
        "enumDescriptions": [
          "Right",
          "Bottom"
        ],
        "default": "right",
        "description": "Git Log: Diff Preview Location."
      },
      "gitPrism.log.showBranches": {
        "type": "boolean",
        "default": true,
        "description": "Git Log: show the branches tree on the left of the log."
      }
    }
  }
}
