{
  "commands": [
    {
      "command": "gitPrism.push",
      "title": "Push\u2026",
      "category": "Git",
      "icon": "$(arrow-up)"
    },
    {
      "command": "gitPrism.pull",
      "title": "Pull\u2026",
      "category": "Git",
      "icon": "$(arrow-down)"
    },
    {
      "command": "gitPrism.fetch",
      "title": "Fetch",
      "category": "Git",
      "icon": "$(repo-fetch)"
    },
    {
      "command": "gitPrism.updateProject",
      "title": "Update Project\u2026",
      "category": "Git",
      "icon": "$(arrow-down)"
    },
    {
      "command": "gitPrism.merge",
      "title": "Merge\u2026",
      "category": "Git",
      "icon": "$(git-merge)"
    },
    {
      "command": "gitPrism.rebase",
      "title": "Rebase\u2026",
      "category": "Git"
    },
    {
      "command": "gitPrism.resetHead",
      "title": "Reset HEAD\u2026",
      "category": "Git"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "gitPrism.push",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.pull",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.fetch",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.updateProject",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.merge",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.rebase",
        "when": "gitPrism.active"
      },
      {
        "command": "gitPrism.resetHead",
        "when": "gitPrism.active"
      }
    ],
    "gitPrism.fileMenu": [
      {
        "command": "gitPrism.push",
        "group": "4_remote@1"
      },
      {
        "command": "gitPrism.updateProject",
        "group": "4_remote@4"
      },
      {
        "command": "gitPrism.pull",
        "group": "4_remote@2"
      },
      {
        "command": "gitPrism.fetch",
        "group": "4_remote@3"
      },
      {
        "command": "gitPrism.merge",
        "group": "5_branch@0.1"
      },
      {
        "command": "gitPrism.rebase",
        "group": "5_branch@0.2"
      },
      {
        "command": "gitPrism.resetHead",
        "group": "5_branch@3.5"
      }
    ]
  },
  "configuration": {
    "properties": {
      "gitPrism.push.protectedBranches": {
        "type": "string",
        "default": "master, main",
        "description": "Protected branches (comma-separated regular expressions). Force Push to them is prohibited."
      },
      "gitPrism.fetch.prune": {
        "type": "boolean",
        "default": true,
        "description": "Prune obsolete remote-tracking references when fetching (--prune)."
      },
      "gitPrism.update.showDialog": {
        "type": "boolean",
        "default": true,
        "description": "Show the Update Project dialog before updating (uncheck \"Don't show this dialog again\" there to bring it back)."
      },
      "gitPrism.update.method": {
        "type": "string",
        "enum": [
          "merge",
          "rebase",
          "branchDefault"
        ],
        "enumDescriptions": [
          "Merge incoming changes into the current branch",
          "Rebase the current branch on top of incoming changes",
          "Branch Default (branch.<name>.rebase / pull.rebase)"
        ],
        "default": "merge",
        "description": "Update method of Update Project and of updating after a rejected push."
      },
      "gitPrism.update.saveChangesPolicy": {
        "type": "string",
        "enum": [
          "stash",
          "shelve"
        ],
        "enumDescriptions": [
          "Using Stash",
          "Using Shelve (mapped to stash in VS Code)"
        ],
        "default": "stash",
        "description": "Clean working tree before update."
      }
    }
  }
}
