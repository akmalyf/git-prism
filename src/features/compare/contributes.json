{
  "commands": [
    { "command": "gitPrism.showDiffWithHead", "title": "Show Diff", "category": "Git", "icon": "$(diff)" },
    { "command": "gitPrism.compareWithRevision", "title": "Compare with Revision…", "category": "Git" },
    { "command": "gitPrism.compareWithBranch", "title": "Compare with Branch or Tag…", "category": "Git" },
    { "command": "gitPrism.compareWithLatest", "title": "Compare with Latest Repository Version", "category": "Git" },
    { "command": "gitPrism.showHistory", "title": "Show History", "category": "Git", "icon": "$(history)" },
    { "command": "gitPrism.showHistoryForSelection", "title": "Show History for Selection…", "category": "Git" },
    { "command": "gitPrism.changes.show", "title": "Show Changes", "category": "Git" },
    { "command": "gitPrism.compare.withCurrent", "title": "Compare with Current", "category": "Git" },
    { "command": "gitPrism.compare.withWorkingTree", "title": "Show Diff with Working Tree", "category": "Git" },
    { "command": "gitPrism.repoAtRevision", "title": "Show Repository at Revision", "category": "Git" },
    { "command": "gitPrism.compare.fileWithRevision", "title": "Compare with Local", "category": "Git" },
    { "command": "gitPrism.openFileAtRevision", "title": "Show File at Revision", "category": "Git" },
    { "command": "gitPrism.compare.showCurrentRevision", "title": "Show Current Revision", "category": "Git" }
  ],
  "menus": {
    "gitPrism.fileMenu": [
      { "command": "gitPrism.showDiffWithHead", "group": "2_diff@1", "when": "resourceScheme == file" },
      { "command": "gitPrism.compareWithRevision", "group": "2_diff@2", "when": "resourceScheme == file && !explorerResourceIsFolder" },
      { "command": "gitPrism.compareWithBranch", "group": "2_diff@3", "when": "resourceScheme == file" },
      { "command": "gitPrism.compareWithLatest", "group": "2_diff@4", "when": "resourceScheme == file" },
      { "command": "gitPrism.showHistory", "group": "2_diff@5", "when": "resourceScheme == file || resourceScheme == gitprism-rev" },
      { "command": "gitPrism.showHistoryForSelection", "group": "2_diff@6", "when": "(resourceScheme == file || resourceScheme == gitprism-rev) && !explorerViewletFocus && !explorerResourceIsFolder" },
      { "command": "gitPrism.compare.showCurrentRevision", "group": "3_rollback@0", "when": "(resourceScheme == file || resourceScheme == gitprism-rev) && !explorerResourceIsFolder" }
    ],
    "commandPalette": [
      { "command": "gitPrism.showDiffWithHead", "when": "gitPrism.active && resourceScheme == file" },
      { "command": "gitPrism.compareWithRevision", "when": "gitPrism.active && resourceScheme == file" },
      { "command": "gitPrism.compareWithBranch", "when": "gitPrism.active" },
      { "command": "gitPrism.compareWithLatest", "when": "gitPrism.active && resourceScheme == file" },
      { "command": "gitPrism.showHistory", "when": "gitPrism.active" },
      { "command": "gitPrism.showHistoryForSelection", "when": "gitPrism.active && editorIsOpen" },
      { "command": "gitPrism.changes.show", "when": "false" },
      { "command": "gitPrism.compare.withCurrent", "when": "gitPrism.active" },
      { "command": "gitPrism.compare.withWorkingTree", "when": "gitPrism.active" },
      { "command": "gitPrism.repoAtRevision", "when": "gitPrism.active" },
      { "command": "gitPrism.compare.fileWithRevision", "when": "false" },
      { "command": "gitPrism.openFileAtRevision", "when": "false" },
      { "command": "gitPrism.compare.showCurrentRevision", "when": "gitPrism.active && resourceScheme == file" }
    ]
  }
}
