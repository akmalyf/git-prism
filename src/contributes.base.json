{
  "viewsContainers": {
    "panel": [
      {
        "id": "gitPrismPanel",
        "title": "Git",
        "icon": "$(git-branch)"
      }
    ]
  },
  "commands": [
    {
      "command": "gitPrism.console.show",
      "title": "Show Git Console",
      "category": "Git"
    }
  ],
  "configuration": {
    "properties": {
      "gitPrism.gitPath": {
        "type": "string",
        "default": "",
        "description": "Path to the git executable. Empty uses `git` from PATH."
      }
    }
  },
  "submenus": [
    {
      "id": "gitPrism.fileMenu",
      "label": "Git"
    }
  ],
  "menus": {
    "editor/context": [
      {
        "submenu": "gitPrism.fileMenu",
        "group": "gitprism@1",
        "when": "gitPrism.active"
      }
    ]
  }
}
